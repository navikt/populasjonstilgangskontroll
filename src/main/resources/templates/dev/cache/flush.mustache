<!doctype html>
<html lang="no">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Flush cache for innlogget bruker</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@navikt/ds-css@8.16.2/dist/index.css" />
    <style>
        body {
            margin: 0;
            min-height: 100vh;
            display: grid;
            place-items: center;
            background: var(--ax-bg-neutral-moderateA, #f3f3f4);
            color: var(--ax-text-neutral, #1f1f1f);
        }

        .aksel-page {
            width: min(100%, 36rem);
            margin: 2rem 1rem;
            padding: 2rem;
            border-radius: var(--ax-radius-8);
            background: var(--ax-bg-surface-default, #fff);
            border: 1px solid var(--ax-border-neutral-subtleA, #d1d6db);
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
        }

        #status {
            min-height: 1.5rem;
            margin-top: 1rem;
        }

        #status.success {
            color: var(--ax-text-success, #0f5f33);
        }

        #status.error {
            color: var(--ax-text-danger, #a40000);
        }
    </style>
</head>
<body>
    <main class="aksel-page">
        <h1 class="aksel-heading aksel-heading--large">Flush cache for ansatt</h1>
        <p class="aksel-body-short">Fjern innslag for Navident i cache.</p>

        <div class="aksel-form-field" style="margin-top: 1rem;">
            <label class="aksel-label" for="navIdent">NAV-ident</label>
            <input class="aksel-text-field__input" id="navIdent" type="text" name="navIdent" placeholder="Skriv inn Navident" pattern="[A-Z][0-9]{6}" title="NAV-ident må være én stor bokstav etterfulgt av 6 sifre" />
        </div>

        <button class="aksel-button" data-variant="primary" type="button" onclick="flushCache()" style="margin-top: 1rem; width: 100%;">Flush cache for ansatt</button>
        <p id="status" class="aksel-body-short" aria-live="polite"></p>
    </main>

    <script>
        async function flushCache() {
            const status = document.getElementById('status');
            const navIdent = document.getElementById('navIdent').value.trim();

            status.classList.remove('success', 'error');

            if (!/^[A-Z][0-9]{6}$/.test(navIdent)) {
                status.textContent = 'Ugyldig NAV-ident. Må være én stor bokstav etterfulgt av 6 sifre.';
                status.classList.add('error');
                return;
            }

            const response = await fetch(`/dev/cache/flush/${encodeURIComponent(navIdent)}/`, {
                method: 'DELETE'
            });

            if (response.ok) {
                const flushed = await response.json();
                status.textContent = flushed ? 'Innslag fjernet' : 'Intet innslag fjernet';
                status.classList.add(flushed ? 'success' : 'error');
                return;
            }

            const contentType = response.headers.get('content-type') ?? '';
            if (contentType.includes('json')) {
                const problem = await response.json();
                status.textContent = problem.detail ?? `Flush feilet: ${response.status}`;
                status.classList.add('error');
                return;
            }

            status.textContent = `Flush feilet: ${response.status}`;
            status.classList.add('error');
        }
    </script>
</body>
</html>
