<!doctype html>
<html lang="no">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Flush cache for innlogget bruker</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@digdir/designsystemet-css@1.21.1/dist/src/index.css" />
    <style>
        body {
            margin: 0;
            min-height: 100vh;
            display: grid;
            place-items: center;
            background: var(--ds-color-neutral-background-tinted, #f3f3f4);
            color: var(--ds-color-neutral-text-default, #292c30);
        }

        .ds-page {
            width: min(100%, 36rem);
            margin: 2rem 1rem;
        }

        #status {
            min-height: 1.5rem;
            margin-top: 1rem;
        }

        #status.success {
            color: var(--ds-color-success-text-default, #023409);
        }

        #status.error {
            color: var(--ds-color-danger-text-default, #590d0d);
        }
    </style>
</head>
<body>
    <main class="ds-page ds-card">
        <h1 class="ds-heading">Flush cache for ansatt</h1>
        <p class="ds-body">Fjern innslag for Navident i cache.</p>

        <div style="margin-top: 1rem; display: grid; gap: 0.5rem;">
            <label class="ds-label" for="navIdent">NAV-ident</label>
            <input class="ds-input" id="navIdent" type="text" name="navIdent" placeholder="Skriv inn Navident" pattern="[A-Z][0-9]{6}" title="NAV-ident må være én stor bokstav etterfulgt av 6 sifre" />
        </div>

        <button class="ds-button" type="button" onclick="flushCache()" style="margin-top: 1rem; width: 100%;">Flush cache for ansatt</button>
        <p id="status" class="ds-body" aria-live="polite"></p>
    </main>

    <script>
        async function flushCache() {
            const status = document.getElementById('status');
            const navIdent = document.getElementById('navIdent').value.trim();

            status.classList.remove('success', 'error');

            if (!/^[A-Z][0-9]{6}$/.test(navIdent)) {
                status.textContent = 'Ugyldig NAV-ident. Må være én stor bokstav etterfulgt av 6 sifre.';
                status.classList.add('error');
                return;
            }

            const response = await fetch(`/dev/cache/flush/${encodeURIComponent(navIdent)}/`, {
                method: 'DELETE'
            });

            if (response.ok) {
                const flushed = await response.json();
                status.textContent = flushed ? 'Innslag fjernet' : 'Intet innslag fjernet';
                status.classList.add(flushed ? 'success' : 'error');
                return;
            }

            const contentType = response.headers.get('content-type') ?? '';
            if (contentType.includes('json')) {
                const problem = await response.json();
                status.textContent = problem.detail ?? `Flush feilet: ${response.status}`;
                status.classList.add('error');
                return;
            }

            status.textContent = `Flush feilet: ${response.status}`;
            status.classList.add('error');
        }
    </script>
</body>
</html>
